// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// Ajout de l'Enum Role
enum Role {
  EMPLOYE
  MANAGER
  ADMIN
}

enum Statut {
  EN_ATTENTE
  VALIDE
  REFUSE
}

model Direction {
  id            Int       @id @default(autoincrement())
  nom_direction String
  services      Service[]
  createdAt     DateTime  @default(now())
}

model Service {
  id          Int       @id @default(autoincrement())
  nom_service String
  directionId Int
  direction   Direction @relation(fields: [directionId], references: [id])
  employes    Employe[]
  createdAt   DateTime  @default(now())
}

model Employe {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  email       String   @unique
  password    String
  adress      String?
  
  // Utilisation de l'Enum ici avec valeur par défaut EMPLOYE
  role        Role     @default(EMPLOYE)

  serviceId   Int?
  service     Service? @relation(fields: [serviceId], references: [id])

  managerId   Int?
  manager     Employe?  @relation("Supervision", fields: [managerId], references: [id])
  subordonnes Employe[] @relation("Supervision")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demandesAbsence DemandeAbsence[]
}
// Enums
enum StatutDemande {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum TypeDemande {
  CONGE
  ABSENCE
  RECUPERATION
}

// Modèle DemandeAbsence (Contient la classe mère + les sous-classes)
model DemandeAbsence {
  id                 Int           @id @default(autoincrement())
  typeDemande        TypeDemande
  dateDebut          DateTime
  dateFin            DateTime
  status             StatutDemande @default(EN_ATTENTE)
  motif              String
  justificatif       String?

  // Champ spécifique à Conge
  type_conge         String?

  // Champ spécifique à Absence
  justifie           Boolean?      @default(false)

  // Champ spécifique à Recuperation
  heures_a_recuperer Float?

  // Relation avec Employe
  employeId          Int
  employe            Employe       @relation(fields: [employeId], references: [id], onDelete: Cascade)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}