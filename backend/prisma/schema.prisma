// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// Ajout de l'Enum Role
enum Role {
  EMPLOYE
  MANAGER
  ADMIN
}

enum Statut {
  EN_ATTENTE
  VALIDE
  REFUSE
}

model Direction {
  id            Int       @id @default(autoincrement())
  nom_direction String
  // 🔑 Un manager optionnel responsable de TOUTE la direction
  managerId   Int?      @unique
  manager     Employe?  @relation("DirectionManager", fields: [managerId], references: [id])
  services      Service[]
  createdAt     DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id          Int       @id @default(autoincrement())
  nom_service String
  directionId Int
  direction   Direction @relation(fields: [directionId], references: [id],onDelete: Cascade)
  // 🔑 Un manager optionnel responsable de ce service spécifique
  managerId   Int?
  manager     Employe?  @relation("ServiceManager", fields: [managerId], references: [id])
  employes    Employe[]
  createdAt   DateTime  @default(now())
}

model Employe {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  email       String   @unique
  password    String
  adress      String?
  
  // Utilisation de l'Enum ici avec valeur par défaut EMPLOYE
  role        Role     @default(EMPLOYE)

  serviceId   Int?
  service     Service? @relation(fields: [serviceId], references: [id])

  managerId   Int?
  manager     Employe?  @relation("Supervision", fields: [managerId], references: [id])
  subordonnes Employe[] @relation("Supervision")

  directionGeree Direction? @relation("DirectionManager")
  servicesGeres  Service[]  @relation("ServiceManager")

  compteur        Compteur?         // Relation 1-to-1 (Tableau de bord de solde global)
  plannings       Planning[]        // Relation 1-to-N (Planning de travail / Shifts)
  pointages       Pointage[]        // Relation 1-to-N (Pointages quotidiens)


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demandesAbsence DemandeAbsence[]
}
// Enums
enum StatutDemande {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum TypeDemande {
  CONGE
  ABSENCE
  RECUPERATION
}

// Modèle DemandeAbsence (Contient la classe mère + les sous-classes)
model DemandeAbsence {
  id                 Int           @id @default(autoincrement())
  typeDemande        TypeDemande
  dateDebut          DateTime
  dateFin            DateTime
  status             StatutDemande @default(EN_ATTENTE)
  motif              String
  justificatif       String?

  // Champ spécifique à Conge
  type_conge         String?

  // Champ spécifique à Absence
  justifie           Boolean?      @default(false)

  // Champ spécifique à Recuperation
  heures_a_recuperer Float?

  // Relation avec Employe
  employeId          Int
  employe            Employe       @relation(fields: [employeId], references: [id], onDelete: Cascade)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Planning {
  id              Int      @id @default(autoincrement())
  employeId       Int
  employe         Employe  @relation(fields: [employeId], references: [id])
  dateDebut       DateTime
  dateFin         DateTime
  heureDebut      String?  // Ex: "06:00" ou "08:00"
  heureFin        String?  // Ex: "14:00" ou "16:00"
  type_travail    String   // "NORMAL", "SHIFT_3X8", "FLEXIBLE", "REPOS"
  typeShift       String?  // "MATIN", "SOIR", "NUIT"
  plageFixeDebut  String?  // "09:30"
  plageFixeFin    String?  // "15:30"
  joursRepos      String?  // "5,6"
  createdAt       DateTime @default(now())
}
// ⏱️ Modèle Pointage : Enregistre l'arrivée, le départ et l'écart du jour
model Pointage {
  id           Int      @id @default(autoincrement())
  date         DateTime // Jour du pointage (YYYY-MM-DD)
  heureDebut   DateTime // Horodatage précis d'arrivée
  heureFin     DateTime?// Horodatage précis de départ (optionnel au moment de l'arrivée)
  dureeHeures  Float?   // Total des heures travaillées dans la journée (ex: 8.5)
  creditDebit  Float?   // Écart de la journée (ex: +0.5 ou -1.0)

  employeId    Int
  employe      Employe  @relation(fields: [employeId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  // 🛡️ EMPÊCHE PHYSIQUEMENT LES DOUBLONS SUR (employeId + date)
  @@unique([employeId, date])
}

// 📊 Modèle Compteur : Stocke les soldes cumulés globaux de l'employé
model Compteur {
  id           Int     @id @default(autoincrement())
  solde_conges Float   @default(25.0) // Solde de jours de congés payés restant
  solde_rtt    Float   @default(0.0)  // Solde en heures RTT
  credit_debit Float   @default(0.0)  // Balance globale cumulée (+ heure sup / - absence)

  employeId    Int     @unique
  employe      Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)
}